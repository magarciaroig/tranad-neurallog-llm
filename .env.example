# =============================================================================
# 🔐 VARIABLES DE ENTORNO PARA PROVEEDORES LLM (AIOps / RCA Assistant)
# =============================================================================
# Copia este archivo como .env para configurar tus credenciales de LLM:
#   cp .env.example .env
#
# NUNCA agregues claves reales a este archivo (.env.example) ni hagas commit de .env.
# =============================================================================

# --- 1. LLMs Comerciales (Opcionales - Descomentar y completar si se usan) ---
# OpenAI (ej. gpt-4o, gpt-4o-mini, o3-mini)
# OPENAI_API_KEY=sk-...

# Anthropic Claude (ej. claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (ej. gemini-2.5-flash, gemini-2.5-pro)
# GEMINI_API_KEY=AIzaSy...

# Groq / DeepSeek API / OpenRouter (Compatibles con OpenAI)
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# --- 2. Servidor Local Ollama (Utilizado por defecto en el TFM) ---
# Por defecto el servidor Ollama corre en http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
